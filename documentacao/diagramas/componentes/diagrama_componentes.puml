@startuml
!theme plain
skinparam componentStyle uml2
skinparam defaultFontName Arial
skinparam roundCorner 8
skinparam shadowing false

title **Diagrama de Componentes UML: Arquitetura de Software do Ecossistema RotaRDV**

package "Cliente Móvel: tcc-despesas-mobile (Flutter / Dart)" #E8F8F5 {
  [UI & Cockpit Screens\n(Widgets Flutter)] as Comp_UI
  [Controllers / ViewModels\n(Gerência de Estado)] as Comp_VM
  [Sync Engine\n(Listener de Conectividade)] as Comp_Sync
  [Storage Cleaner Service\n(Exclusão > 15 dias)] as Comp_Cleaner
  [Local Database\n(Isar NoSQL Database)] as Comp_Isar
  [HTTP Client Resiliente\n(ApiClient / http + JWT)] as Comp_HttpClient

  Comp_UI ..> Comp_VM : interage
  Comp_VM ..> Comp_Isar : lê / escreve
  Comp_VM ..> Comp_Sync : notifica eventos
  Comp_Sync ..> Comp_Isar : consulta pendências
  Comp_Sync ..> Comp_Cleaner : dispara limpeza
  Comp_Sync ..> Comp_HttpClient : usa para Push/Pull
}

package "Backend: tcc-despesas-api (Node.js / Express 5.2)" #EBF5FB {
  [API Gateway & Router\n(Express 5.2 App)] as Comp_Router
  [Middlewares Pipeline\n(Auth, RateLimit, Logs)] as Comp_Middlewares
  [REST Controllers\n(Validação Zod Schemas)] as Comp_Controllers
  [Domain Services\n(Regras de Domínio e RBAC)] as Comp_Services
  [Media Processing Pipeline\n(Sharp mozjpeg 80% & DOMPurify)] as Comp_Sharp
  [Data Access Layer\n(Mongoose Repositories & Discriminators)] as Comp_Repo

  Comp_Router ..> Comp_Middlewares : filtra requisições
  Comp_Middlewares ..> Comp_Controllers : despacha
  Comp_Controllers ..> Comp_Services : orquestra
  Comp_Services ..> Comp_Sharp : processa imagens
  Comp_Services ..> Comp_Repo : persiste dados
}

package "Serviços de Persistência e Infraestrutura Externa" #FEF9E7 {
  database "MongoDB Database\n(Coleções: viagens, despesas, usuarios, empresas)" as Comp_Mongo #PeachPuff
  cloud "Garage S3 Object Storage\n(Bucket de Fotos de Comprovantes)" as Comp_GarageS3 #Wheat
  cloud "Google Identity Platform\n(Google Sign-In OAuth)" as Comp_GoogleAuth #LightGray
  node "Serviço de E-mail Hermes\n(SMTP Mailer / Verificação)" as Comp_SMTP #LightGray
}

' Interfaces e Protocolos
interface "REST API / JSON\n(HTTPS / Bearer JWT)" as Inter_REST
interface "S3 API\n(AWS SDK v3 / SigV4)" as Inter_S3
interface "Wire Protocol\n(MongoDB Driver TCP)" as Inter_Mongo
interface "Google OAuth 2.0 API\n(google-auth-library)" as Inter_GoogleAuth
interface "SMTP / TLS\n(Porta 587 / 465)" as Inter_SMTP

Comp_HttpClient --( Inter_REST
Inter_REST -- Comp_Router

Comp_Repo --( Inter_Mongo
Inter_Mongo -- Comp_Mongo

Comp_Sharp --( Inter_S3
Inter_S3 -- Comp_GarageS3

Comp_Services --( Inter_GoogleAuth
Inter_GoogleAuth -- Comp_GoogleAuth

Comp_Services --( Inter_SMTP
Inter_SMTP -- Comp_SMTP

@enduml
