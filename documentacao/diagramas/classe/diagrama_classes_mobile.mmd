classDiagram
    direction TB

    class LocalDatabase {
        +Isar isar$
        +init()$ Future~void~
    }

    class ViagemCollection {
        +Id id
        +String uuid
        +String origemCidade
        +String origemEstado
        +String destinoCidade
        +String destinoEstado
        +double kmInicial
        +double kmFinal
        +DateTime dataInicio
        +DateTime dataFim
        +String status
        +String statusSincronizacao
    }

    class DespesaCollection {
        +Id id
        +String uuid
        +String viagemId
        +String tipo
        +double valorTotal
        +DateTime data
        +String local
        +String descricao
        +String fotoAnexoLocalPath
        +String fotoAnexoUrl
        +bool fotoTiradaNoApp
        +double litros
        +double valorLitro
        +String tipoCombustivel
        +double kmAtual
        +String statusSincronizacao
    }

    class DioClient {
        -Dio _dio$
        +ValueNotifier~bool~ sessionExpiredNotifier$
        +init()$ void
        +get(path)$ Future~Response~
        +post(path)$ Future~Response~
        +uploadFile(path, file)$ Future~Response~
    }

    class AuthInterceptor {
        -Dio dio
        -Dio _tokenDio
        +onRequest(options, handler)
        +onResponse(response, handler)
        +onError(err, handler)
    }

    class TimeLoggingInterceptor {
        +onRequest(options, handler)
        +onResponse(response, handler)
        +onError(err, handler)
    }

    class AuthService {
        -GoogleSignIn _googleSignIn
        +login(email, senha) Future
        +signInWithGoogle() Future
        +logout() Future
    }

    class SyncService {
        -SyncService _instance$
        +bool isSyncing
        +ValueNotifier~int~ syncEventNotifier
        +initConnectivityListener() void
        +syncAll(maxRetries) Future~void~
        +pushSync() Future~void~
        +pullSync() Future~void~
        +hasPendingSync() Future~bool~
        +getPendingSyncSummary() Future~PendingSyncSummary~
    }

    class PendingSyncSummary {
        +int viagensPendentes
        +int despesasPendentes
        +int fotosPendentes
        +int totalPendencias
        +bool hasPending
    }

    class StorageCleanerService {
        +limparComprovantesAntigosLocais(dias)$ Future~int~
    }

    class AuthViewModel {
        +bool isLoadingLocal
        +bool isLoadingGoogle
        +Map currentUser
        +Map currentVehicle
        +login(email, senha) Future~bool~
        +loginWithGoogle() Future~bool~
        +logout() Future~void~
    }

    class HomeViewModel {
        +AuthViewModel authViewModel
        +bool isLoading
        +List~ViagemCollection~ ultimasViagens
        +bool isSessionExpired
        +init() Future~void~
        +carregarDadosBancoLocal() Future~void~
    }

    class DespesaViewModel {
        +List~DespesaCollection~ despesas
        +bool isLoading
        +String currentViagemId
        +carregarDespesas(viagemUuid) Future~void~
        +salvarDespesa(despesa, fotoPath) Future~bool~
        +calcularMetricasViagem(viagem) MetricasConsumoViagem
    }

    class MetricasConsumoViagem {
        +double totalLitros
        +double kmPercorridoTotal
        +double mediaConsumoGeral
        +int totalAbastecimentos
    }

    %% Relacionamentos
    LocalDatabase ..> ViagemCollection : gerencia
    LocalDatabase ..> DespesaCollection : gerencia
    DespesaCollection --> ViagemCollection : viagemId

    DioClient *-- AuthInterceptor : interceptor
    DioClient *-- TimeLoggingInterceptor : interceptor

    AuthService --> DioClient : http
    AuthViewModel --> AuthService : autentica
    HomeViewModel --> AuthViewModel : observa
    HomeViewModel --> LocalDatabase : le_dados
    HomeViewModel --> SyncService : escuta

    DespesaViewModel --> LocalDatabase : persiste
    DespesaViewModel --> SyncService : sincroniza
    DespesaViewModel ..> MetricasConsumoViagem : calcula

    SyncService --> DioClient : comunica
    SyncService --> LocalDatabase : atualiza
    SyncService --> StorageCleanerService : expurgo
    SyncService ..> PendingSyncSummary : emite
