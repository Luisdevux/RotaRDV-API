{
  "author": "Luis Felipe Lopes",
  "license": "MIT",
  "name": "tcc-despesas-api",
  "version": "1.0.0",
  "description": "API RESTful para aplicativo de registro de despesas de viagens voltado para transportadoras rodoviárias",
  "main": "src/app.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "ssh://git@gitlab.fslab.dev:6666/tcc-registro-de-despesas-luis/tcc-despesas-api.git"
  },
  "scripts": {
    "dev": "docker compose -f docker-compose.dev.yml up --build --force-recreate",
    "dev:local": "npx nodemon server.js",
    "seed": "docker exec -it api-despesas node src/seeds/seeds.js",
    "seed:local": "node src/seeds/seeds.js",
    "test": "jest --coverage --detectOpenHandles",
    "start:local": "node server.js",
    "start": "docker compose -f docker-compose.yml up --build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "@ruanlopes1350/hermes-client": "^1.1.0",
    "axios": "^1.18.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "cpf-cnpj-validator": "^2.1.2",
    "dompurify": "^3.4.11",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-fileupload": "^1.5.2",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.7.0",
    "helmet": "^8.2.0",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.7",
    "mongoose": "^9.7.1",
    "mongoose-paginate-v2": "^1.9.4",
    "multer": "^2.2.0",
    "sharp": "^0.35.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "babel-jest": "^30.4.1",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.4",
    "supertest": "^7.2.2"
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": {
            "node": "current"
          }
        }
      ]
    ],
    "plugins": [
      "babel-plugin-transform-import-meta"
    ]
  },
  "jest": {
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "testEnvironment": "node",
    "verbose": true,
    "transformIgnorePatterns": [
      "/node_modules/(?!uuid)"
    ],
    "roots": [
      "<rootDir>"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/src/config/dbConnect.js",
      "/src/controllers/AuthController.js",
      "/src/service/AuthService.js",
      "/utils/logger.js",
      "/utils/errors",
      "/middlewares/",
      "/utils/AuthHelper.js",
      "/utils/TokenUtil.js",
      "/utils/helpers/errorHandler.js",
      "/utils/helpers/StatusService.js",
      "/utils/helpers/messages.js",
      "/utils/helpers/CommonResponse.js",
      "/middlewares/asyncWrapper.js",
      "utils/helpers/HttpStatusCodes.js"
    ]
  },
  "overrides": {
    "babel-plugin-transform-import-meta": {
      "@babel/core": "$@babel/core"
    },
    "js-yaml": "^4.1.2"
  }
}
