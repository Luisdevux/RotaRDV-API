{
  "author": "Luis Felipe Lopes",
  "license": "MIT",
  "name": "tcc-despesas-api",
  "version": "1.0.0",
  "description": "API RESTful para aplicativo de registro de despesas de viagens voltado para transportadoras rodoviárias",
  "main": "src/app.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "ssh://git@gitlab.fslab.dev:6666/tcc-registro-de-despesas-luis/tcc-despesas-api.git"
  },
  "scripts": {
    "dev": "docker compose -f docker-compose.dev.yml up --build --force-recreate",
    "dev:local": "npx nodemon server.js",
    "seed": "docker exec -it api-despesas node src/seeds/seeds.js",
    "seed:local": "node src/seeds/seeds.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:services": "vitest run src/test/services",
    "test:routes": "vitest run src/test/routes",
    "test:utils": "vitest run src/test/utils",
    "test:auth": "vitest run src/test/services/AuthService.test.js src/test/routes/authRoutes.test.js",
    "test:viagens": "vitest run src/test/services/ViagemService.test.js src/test/routes/viagemRoutes.test.js",
    "test:despesas": "vitest run src/test/services/DespesaService.test.js src/test/routes/despesaRoutes.test.js",
    "test:sync": "vitest run src/test/services/SyncService.test.js src/test/routes/syncRoutes.test.js",
    "test:empresas": "vitest run src/test/services/EmpresaService.test.js src/test/routes/empresaRoutes.test.js",
    "start:local": "node server.js",
    "start": "docker compose -f docker-compose.yml up --build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "@ruanlopes1350/hermes-client": "^1.3.5",
    "axios": "^1.18.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "cpf-cnpj-validator": "^2.1.2",
    "dompurify": "^3.4.11",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-fileupload": "^1.5.2",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.7.0",
    "helmet": "^8.2.0",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.7",
    "mongoose": "^9.7.1",
    "mongoose-paginate-v2": "^1.9.4",
    "sharp": "^0.35.4",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.4",
    "supertest": "^7.2.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "fast-uri": "^3.1.8",
    "qs": "^6.16.0"
  }
}
